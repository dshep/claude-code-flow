# Claude Flow - Environment Configuration Example
# Copy this file to .env.local and fill in your values

# ============================================================================
# Embedding Configuration (for ReasoningBank semantic search)
# ============================================================================

# Option 1: OpenAI (Default - Just set API key)
# ------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Option 2: OpenRouter (Cost-effective alternative)
# ------------------------------------------------
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-your-openrouter-key
# EMBEDDING_PROVIDER_PREFIX=openai/

# Option 3: Requesty.ai Router
# ------------------------------------------------
# OPENAI_BASE_URL=https://router.requesty.ai/v1
# OPENAI_API_KEY=your-requesty-key
# EMBEDDING_PROVIDER_PREFIX=openai/

# Option 4: Together.ai
# ------------------------------------------------
# OPENAI_BASE_URL=https://api.together.xyz/v1
# OPENAI_API_KEY=your-together-key
# EMBEDDING_MODEL=togethercomputer/m2-bert-80M-8k-retrieval
# EMBEDDING_DIMENSIONS=768

# Option 5: Local Ollama
# ------------------------------------------------
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=none
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# ============================================================================
# Advanced Embedding Configuration (Optional)
# ============================================================================

# Model selection (default: text-embedding-3-small)
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_MODEL=text-embedding-3-large  # Higher quality, more expensive

# Vector dimensions (default: 1536 for text-embedding-3-small)
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_DIMENSIONS=3072  # For text-embedding-3-large
# EMBEDDING_DIMENSIONS=768   # For smaller models

# Strict mode (default: true - fail on API errors instead of using hash fallback)
# EMBEDDING_STRICT_MODE=true   # Recommended: Fail fast
# EMBEDDING_STRICT_MODE=false  # Allow hash-based fallback

# Provider prefix (for routers that need provider/model format)
# EMBEDDING_PROVIDER_PREFIX=openai/
# EMBEDDING_PROVIDER_PREFIX=custom/

# ============================================================================
# Notes
# ============================================================================
# 
# 1. For OpenAI: Only OPENAI_API_KEY is required
# 2. For other providers: Set OPENAI_BASE_URL and OPENAI_API_KEY
# 3. Some routers need EMBEDDING_PROVIDER_PREFIX (auto-detected for Requesty/OpenRouter)
# 4. Dimensions must match your model's output dimensions
# 5. Use EMBEDDING_STRICT_MODE=true in production (default)
#
# See: src/reasoningbank/README.md for complete documentation
